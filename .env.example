# ─── Django ────────────────────────────────────────────────────────────
DEBUG=True
DJANGO_SECRET_KEY=replace-me-with-a-long-random-string
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# ─── CORS (Next.js dev server) ─────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ─── Database ──────────────────────────────────────────────────────────
# Set USE_SQLITE_FALLBACK=False (and supply DB_HOST) once MySQL is ready.
USE_SQLITE_FALLBACK=True
DB_NAME=lankaguide
DB_USER=lankaguide_user
DB_PASSWORD=
DB_HOST=
DB_PORT=3306

# ─── Cache (Redis) ─────────────────────────────────────────────────────
REDIS_URL=redis://127.0.0.1:6379/1

# ─── Gemini (Google Generative AI) ─────────────────────────────────────
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-1.5-flash
GEMINI_PRO_MODEL=gemini-1.5-pro
GEMINI_EMBEDDING_MODEL=models/text-embedding-004

# ─── ChromaDB ──────────────────────────────────────────────────────────
CHROMA_PERSIST_DIR=./var/chroma
CHROMA_COLLECTION=sri_lanka_tourism

# ─── Kafka (sentiment pipeline only) ───────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=127.0.0.1:9092
KAFKA_TOPIC_RAW_REVIEWS=raw_reviews
KAFKA_TOPIC_SENTIMENT_DONE=sentiment_done
