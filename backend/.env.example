# ─── Django ────────────────────────────────────────────────────────────
DEBUG=True
DJANGO_SECRET_KEY=replace-me-with-a-long-random-string
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# ─── CORS (Next.js dev server) ─────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ─── Database ──────────────────────────────────────────────────────────
# Keep false to run with MySQL.
USE_SQLITE_FALLBACK=False
DB_NAME=lankaguide
DB_USER=lankaguide_user
DB_PASSWORD=
DB_HOST=
DB_PORT=3306

# ─── Cache (Redis) ─────────────────────────────────────────────────────
REDIS_URL=redis://127.0.0.1:6379/1

# ─── JWT ───────────────────────────────────────────────────────────────
JWT_SIGNING_KEY=

# ─── Google OAuth (Web Client). Leave blank to disable Google sign-in. ─
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Required policy: identify your app — use a real URL or email in production.
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=LankaGuide-AI/1.0 (your-email@example.com)
WIKIPEDIA_LANG=en

# ─── OpenWeatherMap (free) ─────────────────────────────────────────────
OPENWEATHER_API_KEY=

# ─── OSRM public endpoint (free) ───────────────────────────────────────
OSRM_BASE_URL=https://router.project-osrm.org

# ─── Frontend URL (used for share links and password-reset emails) ─────
FRONTEND_URL=http://localhost:3000

# ─── Email (password reset). Console backend prints mail to the terminal. ─
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=noreply@localhost

# ─── Gemini (Google Generative AI) ─────────────────────────────────────
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-2.5-flash
GEMINI_PRO_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# Structured itinerary JSON (RAG); default aligns with academic gemini-1.5-pro claim.
ITINERARY_RAG_MODEL=gemini-1.5-pro
# Short open-meteo sync summaries on SafetyAlert rows.
WEATHER_ALERT_GEMINI_MODEL=gemini-1.5-flash

# ─── ChromaDB ──────────────────────────────────────────────────────────
CHROMA_PERSIST_DIR=./var/chroma
CHROMA_COLLECTION=sri_lanka_tourism

# ─── Kafka (sentiment pipeline only) ───────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=127.0.0.1:9092
KAFKA_TOPIC_RAW_REVIEWS=raw_reviews
KAFKA_TOPIC_SENTIMENT_DONE=sentiment_done
